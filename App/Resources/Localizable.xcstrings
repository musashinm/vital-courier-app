    "Automatic" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático"
          }
        }
      }
    },
    "Automatic uses Apple Watch when it has data, then the source with the most asleep time. If you choose a source, Vital Courier uses it when available, then the same fallback. Changing this rebuilds affected daily notes." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático usa o Apple Watch quando ele tem dados e, se não tiver, a fonte com mais tempo dormindo. Se você escolher uma fonte, o Vital Courier usa essa fonte quando houver dados dela e, se não houver, segue a mesma regra. Mudar isso refaz as notas diárias afetadas."
          }
        }
      }
    },
